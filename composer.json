{
    "name": "gp/sys_template",
    "description": "A sample sys template application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Periyandavar Ganesh",
            "email": "vickyperiyandavar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "gp/sys": "^0.0.2",
        "symfony/yaml": "^6.4"
    },

    "autoload": {
        "psr-4": {
            "App\\": "src\\"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\": "src//",
            "Console\\": "console//"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^12.1",
        "phpstan/phpstan": "^2.1",
        "mockery/mockery": "^1.6"
    }
}
